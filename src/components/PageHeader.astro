---
interface Props {
  title: string;
  subtitle?: string;
  size?: "xl" | "2xl" | "3xl" | "responsive";
  mb?: 0 | 1 | 2 | 4 | 6 | 8;
  class?: string;
}

const {
  title,
  subtitle,
  size = "3xl",
  mb = 6,
  class: extraClass = "",
} = Astro.props;

const sizeClasses: Record<string, string> = {
  xl: "text-2xl",
  "2xl": "text-3xl",
  "3xl": "text-3xl",
  responsive: "text-3xl md:text-4xl",
};

const classes = [
  sizeClasses[size],
  "font-bold",
  `mb-${mb}`,
  "text-fg",
  extraClass,
]
  .filter(Boolean)
  .join(" ");
---
<h1 class={classes}>{title}</h1>
{subtitle && <p class="text-muted mt-2 text-lg">{subtitle}</p>}