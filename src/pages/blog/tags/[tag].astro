---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import EmptyState from "../../../components/EmptyState.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const p of posts) {
    for (const t of p.data.tags || []) tagSet.add(t);
  }
  return Array.from(tagSet).map((tag) => ({ params: { tag } }));
}

export const prerender = true;

const tag = Astro.params.tag;
const posts = (await getCollection("blog", ({ data }) => !data.draft && (data.tags || []).includes(tag))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout pageTitle={`Posts tagged “${tag}” • Fast & Pray`}>
  <PageHeader title={`Posts tagged “${tag}”`} />
  {posts.length === 0 ? (
    <EmptyState message="No posts for this tag." />
  ) : (
    <ul class="space-y-8">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`} class="block group">
            <h2 class="text-2xl font-semibold group-hover:underline text-fg">{post.data.title}</h2>
            {post.data.description && (
              <p class="text-fg mt-1">{post.data.description}</p>
            )}
            <p class="text-sm text-muted mt-1">{post.data.pubDate.toLocaleDateString()}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>


