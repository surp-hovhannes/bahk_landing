---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout pageTitle="Blog • Fast & Pray">
  <PageHeader title="Blog" />
  {posts.length === 0 ? (
    <EmptyState message="No posts yet. Please check back soon." />
  ) : (
    <div class="flex items-center justify-between mb-6">
      <a href="/blog/tags/" class="text-accent hover:underline">Browse by tags</a>
      <a href="/rss.xml" class="text-accent hover:underline">RSS</a>
    </div>
    <ul class="space-y-8">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`} class="block group">
            <h2 class="text-2xl font-semibold group-hover:underline text-fg">{post.data.title}</h2>
            {post.data.description && (
              <p class="text-fg mt-1">{post.data.description}</p>
            )}
            <p class="text-sm text-muted mt-1">{post.data.pubDate.toLocaleDateString()}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>


