---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
const apiBase = import.meta.env.PUBLIC_API_URL ?? "https://api.fastandpray.app";
---

<Layout pageTitle="Icon Library • Fast & Pray">
  <div class="text-fg">
    <PageHeader title="Fast & Pray Icon Library" mb={1} />
    <p class="text-muted mb-6 text-sm">
      Browse and search our collection of icons.
    </p>

    <!-- Search Bar -->
    <div class="flex gap-2 mb-2">
      <input
        id="search-input"
        type="text"
        placeholder="Search icons… (e.g. Nativity, St. Gregory, Baptism)"
        class="flex-1 border border-border rounded-lg px-4 py-2 text-sm focus-ring text-fg"
      />
      <button
        id="search-btn"
        class="bg-fg text-white px-4 py-2 rounded-lg text-sm hover:bg-accent transition whitespace-nowrap"
      >
        Search
      </button>
      <button
        id="ai-btn"
        class="bg-linear-to-r from-accent-alt to-accent-bright text-white px-4 py-2 rounded-lg text-sm hover:opacity-90 transition whitespace-nowrap"
        title="AI-powered semantic search — describe what you're looking for in natural language"
      >
        ✦ AI Match
      </button>
    </div>
    <p class="text-xs text-muted mb-6">
      Use <strong>Search</strong> for keywords, or <strong>AI Match</strong> to describe what you're looking for in natural language.
    </p>

    <!-- Status bar -->
    <div id="status-bar" class="text-sm text-muted min-h-[1.25rem] mb-4"></div>

    <!-- Loading -->
    <div id="loading" class="hidden text-center py-16">
      <div
        class="inline-block w-8 h-8 border-4 border-accent border-t-transparent rounded-full animate-spin mb-3"
      ></div>
      <p class="text-sm text-muted" id="loading-msg">Loading icons…</p>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-16 text-muted">
      <p class="text-xl mb-1">No icons found.</p>
      <p class="text-sm">Try a different search or use AI Match.</p>
    </div>

    <!-- Error state -->
    <div id="error-state" class="hidden text-center py-16 text-danger">
      <p class="text-xl mb-1">Something went wrong.</p>
      <p class="text-sm" id="error-msg"></p>
    </div>

    <!-- Results grid -->
    <div
      id="results-grid"
      class="grid grid-cols-2 sm:grid-cols-3 gap-4"
      style="display:none"
    ></div>

    <!-- Pagination -->
    <div
      id="pagination"
      class="mt-8 flex justify-between items-center"
      style="display:none"
    >
      <button
        id="prev-btn"
        class="px-4 py-2 rounded-lg border border-fg text-fg text-sm disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-fg hover:enabled:text-white transition"
      >
        ← Previous
      </button>
      <span id="page-info" class="text-sm text-muted"></span>
      <button
        id="next-btn"
        class="px-4 py-2 rounded-lg border border-fg text-fg text-sm disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-fg hover:enabled:text-white transition"
      >
        Next →
      </button>
    </div>
  </div>
</Layout>



<script define:vars={{ apiBase }}>
  const PAGE_SIZE = 15;

  let currentPage = 1;
  let currentSearch = ""; // sent as ?search= (title lookup)
  let currentTags = "";   // sent as ?tags= (tag filter, from tag links)
  let totalCount = 0;

  // DOM refs
  const searchInput = document.getElementById("search-input");
  const searchBtn = document.getElementById("search-btn");
  const aiBtn = document.getElementById("ai-btn");
  const statusBar = document.getElementById("status-bar");
  const loading = document.getElementById("loading");
  const loadingMsg = document.getElementById("loading-msg");
  const emptyState = document.getElementById("empty-state");
  const errorState = document.getElementById("error-state");
  const errorMsg = document.getElementById("error-msg");
  const resultsGrid = document.getElementById("results-grid");
  const pagination = document.getElementById("pagination");
  const prevBtn = document.getElementById("prev-btn");
  const nextBtn = document.getElementById("next-btn");
  const pageInfo = document.getElementById("page-info");

  function escape(str) {
    return String(str ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function setLoading(msg = "Loading icons…") {
    loadingMsg.textContent = msg;
    loading.classList.remove("hidden");
    resultsGrid.style.display = "none";
    pagination.style.display = "none";
    emptyState.classList.add("hidden");
    errorState.classList.add("hidden");
  }

  function setError(msg) {
    loading.classList.add("hidden");
    errorMsg.textContent = msg;
    errorState.classList.remove("hidden");
    resultsGrid.style.display = "none";
    pagination.style.display = "none";
  }

  function confidenceBadgeHtml(confidence) {
    if (!confidence) return "";
    const dot = confidence === "high" ? "●" : confidence === "medium" ? "◐" : "○";
    const bgClass = confidence === "high" ? "bg-success/10 text-success" : confidence === "medium" ? "bg-warn/10 text-warn" : "bg-muted/10 text-muted";
    return `<span class="${bgClass} text-xs px-2 py-0.5 rounded-full" aria-label="Confidence: ${escape(confidence)}" data-testid="confidence-badge">${dot} ${escape(confidence)}</span>`;
  }

  function iconCardHtml(icon, confidence = null) {
    const tags = (icon.tag_list ?? []).slice(0, 3);
    const tagChips = tags
      .map(
        (t) =>
          `<span class="bg-accent-alt/10 text-accent-alt text-xs px-2 py-0.5 rounded-full">${escape(t)}</span>`
      )
      .join("");

    const imgSrc = icon.thumbnail_url || icon.image;
    const imgHtml = imgSrc
      ? `<img src="${escape(imgSrc)}" alt="${escape(icon.title)}" loading="lazy" class="object-cover w-full h-full" />`
      : `<div class="flex items-center justify-center w-full h-full text-2xl text-muted font-bold select-none">${escape(icon.title.charAt(0).toUpperCase())}</div>`;

    return `
      <a href="/icons/${icon.id}" class="block bg-surface rounded-lg shadow-xs overflow-hidden border border-border hover:shadow-md transition">
        <div class="aspect-square bg-surface overflow-hidden">${imgHtml}</div>
        <div class="p-3">
          <h3 class="font-semibold text-fg text-sm leading-tight mb-1 line-clamp-2">${escape(icon.title)}</h3>
          ${icon.church_name ? `<p class="text-xs text-muted mb-2">${escape(icon.church_name)}</p>` : ""}
          <div class="flex flex-wrap gap-1 items-center">
            ${tagChips}
            ${confidence ? confidenceBadgeHtml(confidence) : ""}
          </div>
        </div>
      </a>
    `;
  }

  function renderIcons(icons, aiMatches = null) {
    loading.classList.add("hidden");

    if (!icons.length) {
      emptyState.classList.remove("hidden");
      resultsGrid.style.display = "none";
      return;
    }

    emptyState.classList.add("hidden");
    resultsGrid.style.display = "grid";

    if (aiMatches) {
      resultsGrid.innerHTML = aiMatches
        .filter((m) => m.icon)
        .map((m) => iconCardHtml(m.icon, m.confidence))
        .join("");
    } else {
      resultsGrid.innerHTML = icons.map((icon) => iconCardHtml(icon)).join("");
    }
  }

  async function doSearch(page = 1) {
    setLoading("Loading icons…");

    const params = new URLSearchParams({ page: String(page) });
    if (currentSearch) params.set("search", currentSearch);
    if (currentTags) params.set("tags", currentTags);

    try {
      const res = await fetch(`${apiBase}/api/icons/?${params}`);
      if (!res.ok) throw new Error(`Server error ${res.status}`);
      const data = await res.json();

      totalCount = data.count ?? 0;
      currentPage = page;
      const icons = data.results ?? [];
      const totalPages = Math.ceil(totalCount / PAGE_SIZE);

      statusBar.textContent = currentSearch
        ? `${totalCount} result${totalCount !== 1 ? "s" : ""} for "${currentSearch}"`
        : `${totalCount} icon${totalCount !== 1 ? "s" : ""} in the library`;

      renderIcons(icons);

      if (totalPages > 1) {
        pagination.style.display = "flex";
        prevBtn.disabled = !data.previous;
        nextBtn.disabled = !data.next;
        pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      } else {
        pagination.style.display = "none";
      }
    } catch (e) {
      setError(e.message || "Could not reach the icon service. Please try again.");
    }
  }

  async function doAiMatch() {
    const query = searchInput.value.trim();
    if (!query) {
      searchInput.focus();
      return;
    }

    setLoading("Finding the best matching icons…");
    statusBar.textContent = "";

    try {
      const res = await fetch(`${apiBase}/api/icons/match/`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ prompt: query, return_format: "full", max_results: 9 }),
      });
      if (!res.ok) throw new Error(`Server error ${res.status}`);
      const data = await res.json();

      const matches = data.matches ?? [];
      statusBar.textContent =
        matches.length > 0
          ? `AI found ${matches.length} match${matches.length !== 1 ? "es" : ""} for "${query}"`
          : `No AI matches found for "${query}"`;

      renderIcons(matches.map((m) => m.icon).filter(Boolean), matches);
    } catch (e) {
      setError(e.message || "AI matching failed. Please try again.");
    }
  }

  // Event listeners
  searchBtn.addEventListener("click", () => {
    currentSearch = searchInput.value.trim();
    currentTags = ""; // user-typed search overrides any tag filter
    doSearch(1);
  });

  aiBtn.addEventListener("click", doAiMatch);

  searchInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      currentSearch = searchInput.value.trim();
      currentTags = "";
      doSearch(1);
    }
  });

  prevBtn.addEventListener("click", () => {
    if (currentPage > 1) doSearch(currentPage - 1);
  });

  nextBtn.addEventListener("click", () => {
    doSearch(currentPage + 1);
  });

  // Pick up ?tags= from detail page tag links
  const urlParams = new URLSearchParams(window.location.search);
  const tagParam = urlParams.get("tags");
  if (tagParam) {
    searchInput.value = tagParam;
    currentTags = tagParam;
  }
  doSearch(1);
</script>
