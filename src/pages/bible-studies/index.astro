---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getCollection } from "astro:content";

const allEntries = await getCollection("bibleStudies");
// Index entries are those without `session` data — these are the study overviews
const studies = allEntries.filter((entry) => !entry.data.session);
// For each study, find its sessions and count them
const studyMap = studies.map((study) => {
  const sessions = allEntries.filter(
    (e) => e.data.studySlug === study.data.studySlug && e.data.session
  );
  const sessionCount = sessions.length;
  return { study, sessionCount };
});
---

<Layout pageTitle="Guided Bible Studies • Fast & Pray">
  <div>
    <PageHeader title="Guided Bible Studies" mb={2} />
    <p class="text-muted mb-8">
      Journey through Scripture with guided reflections, prayer, and group discussion questions.
    </p>

    {studyMap.length === 0 ? (
      <EmptyState message="No Bible studies available yet. Please check back soon." />
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {studyMap.map(({ study, sessionCount }) => (
          <a
            href={`/bible-studies/${study.data.studySlug}/`}
            class="block group rounded-lg border border-border overflow-hidden hover:shadow-lg transition-shadow"
          >
            {study.data.coverImage ? (
              <div class="aspect-square overflow-hidden">
                <img
                  src={study.data.coverImage.src}
                  alt={study.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                />
              </div>
            ) : (
              <div class="aspect-square bg-linear-to-br from-accent-alt/10 to-fg/10 flex items-center justify-center">
                <span class="text-4xl">📖</span>
              </div>
            )}
            <div class="p-4">
              <h2 class="text-lg font-semibold text-fg group-hover:text-accent-alt transition-colors">
                {study.data.title}
              </h2>
              <p class="text-sm text-muted mt-1 line-clamp-2">
                {study.data.description}
              </p>
              <p class="text-xs text-accent-alt mt-2 font-medium">
                {sessionCount} {sessionCount === 1 ? "session" : "sessions"}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
