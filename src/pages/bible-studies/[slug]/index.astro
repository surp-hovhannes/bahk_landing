---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { getCollection, render } from "astro:content";

const { slug } = Astro.params;
const allEntries = await getCollection("bibleStudies");
const slugEntries = allEntries.filter((e) => e.data.studySlug === slug);

if (slugEntries.length === 0) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

// Index entry (no session data)
const study = slugEntries.find((e) => !e.data.session);
if (!study) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

// Session entries sorted by day
const sessions = slugEntries
  .filter((e) => e.data.session)
  .sort((a, b) => (a.data.session?.day ?? 0) - (b.data.session?.day ?? 0));

const { Content } = await render(study);
---

<Layout pageTitle={`${study.data.title} • Fast & Pray`}>
  <Fragment slot="meta">
    <meta name="description" content={study.data.description} />
  </Fragment>

  <article class="max-w-prose mx-auto">
    <!-- Back link -->
    <a href="/bible-studies" class="text-accent-alt hover:underline text-sm mb-4 inline-block">
      &larr; All Bible Studies
    </a>

    <!-- Cover image -->
    {study.data.coverImage && (
      <div class="aspect-[2/1] overflow-hidden rounded-lg mb-6">
        <img
          src={study.data.coverImage.src}
          alt={study.data.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <PageHeader title={study.data.title} mb={2} />

    <!-- Description -->
    <p class="text-muted mb-6">{study.data.description}</p>

    <!-- Intro body -->
    <div class="prose prose-slate max-w-none mb-8">
      <Content />
    </div>

    <!-- Download prompt -->
    <div class="bg-accent-alt/5 border border-accent-alt/20 rounded-lg p-4 mb-8">
      <p class="text-sm text-fg">
        <a
          href="https://fastandpray.app"
          class="text-accent-alt font-semibold hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Download Fast &amp; Pray
        </a>
        to access our wide library of devotional series and more.
      </p>
    </div>

    <!-- Session list -->
    <h2 class="text-2xl font-semibold text-fg mb-4">Sessions</h2>
    <div class="space-y-3">
      {sessions.map((session) => (
        <a
          href={`/bible-studies/${slug}/${session.data.session?.day}/`}
          class="block border border-border rounded-lg p-4 hover:border-accent-alt hover:shadow-xs transition-all"
        >
          <div class="flex items-center gap-3">
            <span class="shrink-0 w-8 h-8 rounded-full bg-accent-alt text-white flex items-center justify-center text-sm font-bold">
              {session.data.session?.day}
            </span>
            <div>
              <h3 class="font-semibold text-fg">{session.data.session?.title}</h3>
              <p class="text-sm text-muted">Day {session.data.session?.day}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </article>
</Layout>
