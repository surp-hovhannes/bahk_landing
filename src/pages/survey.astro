---
import Layout from "../layouts/Layout.astro";
import CtaButton from "../components/CtaButton.astro";
import PageHeader from "../components/PageHeader.astro";

type SingleChoiceQuestion = {
  kind: "single";
  id: string;
  number: number;
  text: string;
  options: string[];
  optional?: boolean;
  helpText?: string;
  followUp?: {
    id: string;
    prompt: string;
    placeholder?: string;
    inputType?: "text" | "textarea";
    maxLength?: number;
    showForOptions?: string[];
  };
};

type MultiChoiceQuestion = {
  kind: "multi";
  id: string;
  number: number;
  text: string;
  options: string[];
  helpText?: string;
};

type ScaleQuestion = {
  kind: "scale";
  id: string;
  number: number;
  text: string;
  min: number;
  max: number;
  step?: number;
  defaultValue?: number;
  leftLabel: string;
  rightLabel: string;
  helpText?: string;
};

type TextQuestion = {
  kind: "text";
  id: string;
  number: number;
  text: string;
  multiline?: boolean;
  optional?: boolean;
  inputType?: "text" | "email";
  helpText?: string;
};

type Question = SingleChoiceQuestion | MultiChoiceQuestion | ScaleQuestion | TextQuestion;

type Section = {
  id: string;
  title: string;
  questions: Question[];
};

const sections: Section[] = [
  {
    id: "A",
    title: "Section A: About You",
    questions: [
      {
        kind: "single",
        id: "q01",
        number: 1,
        text: "How long have you been using Fast & Pray?",
        options: ["Less than 1 month", "1-3 months", "3-6 months", "6-12 months", "1+ years"],
      },
      {
        kind: "single",
        id: "q02",
        number: 2,
        text: "How often do you use Fast & Pray?",
        options: ["Daily", "A few times a week", "Weekly", "Only during fasting seasons"],
      },
      {
        kind: "single",
        id: "q03",
        number: 3,
        text: "Where are you primarily in your spiritual life right now?",
        options: [
          "New to structured prayer/fasting",
          "Returning after a gap",
          "Consistent but seeking deeper growth",
          "Already very consistent",
        ],
      },
      {
        kind: "single",
        id: "q04",
        number: 4,
        text: "Which tradition best describes you?",
        options: ["Armenian Apostolic", "Other Orthodox", "Catholic", "Protestant", "Other", "Prefer not to say"],
        optional: true,
      },
    ],
  },
  {
    id: "B",
    title: "Section B: Spiritual Impact",
    questions: [
      {
        kind: "text",
        id: "q05",
        number: 5,
        text: "In what ways (if any) has Fast & Pray affected your spiritual life?",
        multiline: true,
        optional: true,
      },
      {
        kind: "scale",
        id: "q06",
        number: 6,
        text: "Compared to before using the app, how has your overall spiritual consistency changed?",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Much less consistent",
        rightLabel: "Much more consistent",
        helpText: "Scale: 1 = Much less consistent, 5 = Much more consistent overall.",
      },
      {
        kind: "single",
        id: "q13",
        number: 7,
        text: "Has the app helped you understand the meaning of fasting beyond food rules?",
        options: ["Not at all", "A little", "Somewhat", "A lot", "Very much"],
        helpText: "Optional follow-up: If yes, how?",
        followUp: {
          id: "q13_followup",
          prompt: "If yes, how?",
          placeholder: "Share any details...",
          inputType: "textarea",
          maxLength: 280,
          showForOptions: ["A little", "Somewhat", "A lot", "Very much"],
        },
      },
    ],
  },
  {
    id: "C",
    title: "Section C: Spiritual Community and Solidarity",
    questions: [
      {
        kind: "single",
        id: "q14",
        number: 8,
        text: "When you see that others are joining the same fast or practice, how does it affect you?",
        options: [
          "It encourages me a lot",
          "It encourages me somewhat",
          "No real effect",
          "It makes me feel pressure or comparison sometimes",
        ],
        helpText: "Optional follow-up: If you chose the last option, what would make this healthier?",
        followUp: {
          id: "q14_followup",
          prompt: "What would make this healthier for you?",
          placeholder: "Your thoughts...",
          inputType: "textarea",
          maxLength: 280,
          showForOptions: ["It makes me feel pressure or comparison sometimes"],
        },
      },
      {
        kind: "scale",
        id: "q15",
        number: 9,
        text: "How much has Fast & Pray strengthened your sense of spiritual community?",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Not at all",
        rightLabel: "Very much",
        helpText: "Scale: 1 = Not at all, 5 = Very much.",
      },
    ],
  },
  {
    id: "D",
    title: 'Section D: "Everyday Monasticism"',
    questions: [
      {
        kind: "single",
        id: "q18",
        number: 10,
        text: "Has the app helped you build a daily rhythm (a rule of life) that you can actually keep?",
        options: ["Yes", "Somewhat", "Not really", "No"],
        helpText: "Optional follow-up: What does your rhythm look like right now?",
        followUp: {
          id: "q18_followup",
          prompt: "What does your rhythm look like right now?",
          placeholder: "For example: morning prayer, evening prayer, etc.",
          inputType: "textarea",
          maxLength: 320,
          showForOptions: ["Yes", "Somewhat", "Not really"],
        },
      },
      {
        kind: "multi",
        id: "q19",
        number: 11,
        text: "Which practices has Fast & Pray most helped you keep?",
        options: [
          "Keeping track of fast days",
          "Starting the day with prayer",
          "Evening prayer",
          "Reading Scripture",
          "Acts of mercy/almsgiving",
          "Preparing for confession",
          "Learning about feasts/saints",
        ],
        helpText: "Check all that apply.",
      },
      {
        kind: "single",
        id: "q20",
        number: 12,
        text: "What is the biggest obstacle to keeping a consistent spiritual rhythm?",
        options: ["Time", "Forgetfulness", "Lack of clarity", "Feeling discouraged", "Family schedule", "Work", "Other"],
        helpText: "Optional follow-up: What in the app helps you with this obstacle?",
        followUp: {
          id: "q20_followup",
          prompt: "What in the app helps you with this obstacle?",
          placeholder: "Share anything that helps...",
          inputType: "textarea",
          maxLength: 280,
        },
      },
    ],
  },
  {
    id: "E",
    title: "Section E: What to Improve",
    questions: [
      {
        kind: "text",
        id: "q22",
        number: 13,
        text: "Which parts of Fast & Pray feel most spiritually helpful, and which feel unclear or unhelpful?",
        multiline: true,
        optional: true,
      },
      {
        kind: "single",
        id: "q24",
        number: 14,
        text: "Have you ever felt guilt, pressure, or comparison from using the app?",
        options: ["Never", "Rarely", "Sometimes", "Often"],
        helpText: "Optional follow-up: If yes, what triggered that feeling?",
        followUp: {
          id: "q24_followup",
          prompt: "If yes, what triggered that feeling?",
          placeholder: "Share what happened...",
          inputType: "textarea",
          maxLength: 280,
          showForOptions: ["Rarely", "Sometimes", "Often"],
        },
      },
      {
        kind: "text",
        id: "q25",
        number: 15,
        text: "What is one feature or change that would most support your spiritual growth?",
        multiline: true,
        optional: true,
      },
    ],
  },
  {
    id: "F",
    title: "Section F: Stories and Permission",
    questions: [
      {
        kind: "text",
        id: "q26",
        number: 16,
        text: "Can you share a specific moment where Fast & Pray helped you pray, fast, or return to God?",
        multiline: true,
        optional: true,
      },
      {
        kind: "single",
        id: "q27",
        number: 17,
        text: "May we quote your response (anonymously) for improving the app or sharing its mission?",
        options: ["Yes, anonymously", "Yes, with my first name", "No"],
        helpText: "Optional follow-up: If you selected first name, share it below.",
        followUp: {
          id: "q27_followup",
          prompt: "First name (optional)",
          placeholder: "Your first name",
          inputType: "text",
          maxLength: 40,
          showForOptions: ["Yes, with my first name"],
        },
      },
      {
        kind: "text",
        id: "q28",
        number: 18,
        text: "If you're open to a follow-up conversation, leave your email.",
        inputType: "email",
        optional: true,
      },
    ],
  },
];

const questionIds = sections.flatMap((section) => section.questions.map((question) => question.id));
const multiQuestionIds = sections.flatMap((section) =>
  section.questions.filter((question) => question.kind === "multi").map((question) => question.id)
);
const followUpMappings = sections.flatMap((section) =>
  section.questions.flatMap((question) =>
    question.kind === "single" && question.followUp
      ? [{ parentId: question.id, followUpId: question.followUp.id }]
      : []
  )
);
---

<Layout pageTitle="Fast & Pray Research Survey">
  <section class="text-fg">
    <PageHeader title="Fast & Pray Research Survey" mb={0} />
    <p class="mt-2 text-sm md:text-base">
      Please complete the survey. Responses are submitted securely for research analysis.
    </p>

    <form
      id="survey-form"
      class="mt-8 space-y-8"
      data-question-ids={JSON.stringify(questionIds)}
      data-multi-question-ids={JSON.stringify(multiQuestionIds)}
      data-follow-up-mappings={JSON.stringify(followUpMappings)}
    >
      {
        sections.map((section, sectionIndex) => (
          <fieldset
            class={`border border-accent rounded-lg p-4 md:p-6 ${sectionIndex === 0 ? "" : "hidden"}`}
            data-survey-section
            data-section-index={sectionIndex}
          >
            <legend class="px-2 text-lg font-semibold">{section.title}</legend>
            <div class="mt-3 space-y-6">
              {section.questions.map((question) => (
                <div class="space-y-3" data-question-id={question.id}>
                  <p class="font-semibold" id={`${question.id}-label`}>
                    {question.number}. {question.text}
                    {"optional" in question && question.optional && (
                      <span class="ml-2 rounded-full border border-accent px-2 py-0.5 text-xs font-medium text-fg-muted">
                        Optional
                      </span>
                    )}
                  </p>

                  {question.helpText && <p class="text-sm text-fg-muted">{question.helpText}</p>}

                  {question.kind === "single" ? (
                    <div class="space-y-2">
                      {question.options.map((option, optionIndex) => (
                        <label class="flex items-start gap-2" for={`${question.id}-option-${optionIndex}`}>
                          <input
                            class="mt-1"
                            type="radio"
                            id={`${question.id}-option-${optionIndex}`}
                            name={question.id}
                            value={option}
                            required={!question.optional}
                          />
                          <span>{option}</span>
                        </label>
                      ))}
                      {question.followUp && (
                        <div
                          class="hidden space-y-2 rounded-md border border-accent/70 bg-white/50 p-3 md:p-4"
                          data-followup-wrapper={question.id}
                          data-followup-input-id={question.followUp.id}
                          data-followup-show-for={JSON.stringify(question.followUp.showForOptions ?? [])}
                        >
                          <label class="text-sm font-medium text-fg-muted" for={question.followUp.id}>
                            {question.followUp.prompt}
                            <span class="ml-2 rounded-full border border-accent px-2 py-0.5 text-xs font-medium">
                              Optional
                            </span>
                          </label>
                          {question.followUp.inputType === "text" ? (
                            <input
                              class="w-full rounded-md border border-accent p-3 focus-ring"
                              id={question.followUp.id}
                              name={question.followUp.id}
                              type="text"
                              placeholder={question.followUp.placeholder}
                              maxlength={question.followUp.maxLength}
                              data-followup-counter-for={question.followUp.id}
                            />
                          ) : (
                            <textarea
                              class="w-full rounded-md border border-accent p-3 focus-ring"
                              id={question.followUp.id}
                              name={question.followUp.id}
                              rows={4}
                              placeholder={question.followUp.placeholder}
                              maxlength={question.followUp.maxLength}
                              data-followup-counter-for={question.followUp.id}
                            ></textarea>
                          )}
                          {question.followUp.maxLength && (
                            <p
                              class="text-right text-xs text-fg-muted"
                              data-followup-counter={question.followUp.id}
                            >{`0/${question.followUp.maxLength}`}</p>
                          )}
                        </div>
                      )}
                    </div>
                  ) : question.kind === "scale" ? (
                    <div class="space-y-2">
                      <div class="flex items-center gap-3">
                        <label class="sr-only" for={question.id}>
                          {question.text}
                        </label>
                        <input
                          class="w-full accent-accent-alt"
                          type="range"
                          id={question.id}
                          name={question.id}
                          min={question.min}
                          max={question.max}
                          step={question.step ?? 1}
                          value={question.defaultValue ?? Math.round((question.min + question.max) / 2)}
                          data-scale-input={question.id}
                        />
                        <output
                          class="min-w-8 rounded border border-accent px-2 py-1 text-center text-sm font-semibold"
                          data-scale-output={question.id}
                        >
                          {question.defaultValue ?? Math.round((question.min + question.max) / 2)}
                        </output>
                      </div>
                      <div class="flex justify-between text-xs text-fg-muted">
                        <span>{question.leftLabel}</span>
                        <span>{question.rightLabel}</span>
                      </div>
                      <div class="flex justify-between text-xs text-fg-muted">
                        {Array.from({ length: question.max - question.min + 1 }, (_, i) => question.min + i).map(
                          (value) => (
                            <span>{value}</span>
                          )
                        )}
                      </div>
                    </div>
                  ) : question.kind === "multi" ? (
                    <div class="space-y-2">
                      {question.options.map((option, optionIndex) => (
                        <label class="flex items-start gap-2" for={`${question.id}-option-${optionIndex}`}>
                          <input
                            class="mt-1"
                            type="checkbox"
                            id={`${question.id}-option-${optionIndex}`}
                            name={question.id}
                            value={option}
                          />
                          <span>{option}</span>
                        </label>
                      ))}
                    </div>
                  ) : question.multiline ? (
                    <>
                      <label class="sr-only" for={question.id}>
                        {question.text}
                      </label>
                      <textarea
                        class="w-full rounded-md border border-accent p-3 focus-ring"
                        id={question.id}
                        name={question.id}
                        rows={5}
                        required={!question.optional}
                      ></textarea>
                    </>
                  ) : (
                    <>
                      <label class="sr-only" for={question.id}>
                        {question.text}
                      </label>
                      <input
                        class="w-full rounded-md border border-accent p-3 focus-ring"
                        id={question.id}
                        name={question.id}
                        type={question.inputType ?? "text"}
                        required={!question.optional}
                      />
                    </>
                  )}
                </div>
              ))}
            </div>
          </fieldset>
        ))
      }

      <div class="space-y-3">
        <p id="section-progress" class="text-sm font-medium text-fg-muted" aria-live="polite"></p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <button
            id="back-button"
            type="button"
            class="w-full sm:w-auto rounded-full border border-accent px-6 py-3 text-base font-medium text-fg disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            Back
          </button>
          <CtaButton
            id="next-button"
            type="button"
            text="Next Section"
            fullWidth
          />
          <CtaButton
            id="submit-button"
            type="submit"
            text="Submit Survey"
            fullWidth
            class="hidden"
          />
        </div>
        <p id="survey-status" class="min-h-6 text-sm" aria-live="polite"></p>
      </div>
    </form>
  </section>
</Layout>

<script>
  const SUPABASE_URL = "https://czpmtdcjogaueynyyioi.supabase.co";
  const SUPABASE_ANON_KEY = "sb_publishable_TLJwcn8vXKUnrlXCeJTE-Q_F4_ooUcX";
  const TABLE = "fast_pray_survey_responses";

  const form = document.getElementById("survey-form") as HTMLFormElement | null;
  const status = document.getElementById("survey-status") as HTMLParagraphElement | null;
  const sectionProgress = document.getElementById("section-progress") as HTMLParagraphElement | null;
  const backButton = document.getElementById("back-button") as HTMLButtonElement | null;
  const nextButton = document.getElementById("next-button") as HTMLButtonElement | null;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement | null;
  const scaleInputs = document.querySelectorAll("input[data-scale-input]") as NodeListOf<HTMLInputElement>;
  const sectionFieldsets = Array.from(
    document.querySelectorAll("fieldset[data-survey-section]")
  ) as HTMLFieldSetElement[];
  let currentSectionIndex = 0;

  function syncScaleOutputs() {
    scaleInputs.forEach((input) => {
      if (!(input instanceof HTMLInputElement)) return;
      const key = input.dataset.scaleInput;
      if (!key) return;
      const output = document.querySelector(`output[data-scale-output="${key}"]`);
      if (output) {
        output.textContent = input.value;
      }
    });
  }

  function parseStringArray(rawValue: string | undefined): string[] {
    if (!rawValue) return [];

    try {
      const parsed: unknown = JSON.parse(rawValue);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((value): value is string => typeof value === "string");
    } catch {
      return [];
    }
  }

  function parseFollowUpMappings(
    rawValue: string | undefined
  ): Array<{ parentId: string; followUpId: string }> {
    if (!rawValue) return [];

    try {
      const parsed: unknown = JSON.parse(rawValue);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (value): value is { parentId: string; followUpId: string } =>
          typeof value === "object" &&
          value !== null &&
          "parentId" in value &&
          "followUpId" in value &&
          typeof value.parentId === "string" &&
          typeof value.followUpId === "string"
      );
    } catch {
      return [];
    }
  }

  function updateFollowUpVisibility(parentId: string) {
    if (!form) return;

    const wrapper = form.querySelector(`[data-followup-wrapper="${parentId}"]`) as HTMLDivElement | null;
    if (!wrapper) return;

    const selectedOption = form.querySelector(`input[name="${parentId}"]:checked`) as HTMLInputElement | null;
    const showForOptions = parseStringArray(wrapper.dataset.followupShowFor);
    const followUpInputId = wrapper.dataset.followupInputId;

    const shouldShow = Boolean(
      selectedOption && (showForOptions.length === 0 || showForOptions.includes(selectedOption.value))
    );

    wrapper.classList.toggle("hidden", !shouldShow);

    if (shouldShow || !followUpInputId) return;

    const followUpInput = form.querySelector(`[name="${followUpInputId}"]`) as
      | HTMLInputElement
      | HTMLTextAreaElement
      | null;
    if (followUpInput) {
      followUpInput.value = "";
      updateFollowUpCounter(followUpInput);
    }
  }

  function updateFollowUpCounter(input: HTMLInputElement | HTMLTextAreaElement) {
    if (!form) return;
    const counter = form.querySelector(`[data-followup-counter="${input.name}"]`) as HTMLParagraphElement | null;
    if (!counter) return;
    counter.textContent = `${input.value.length}/${input.maxLength}`;
  }

  function bindFollowUpCounter(inputId: string) {
    if (!form) return;
    const input = form.querySelector(`[name="${inputId}"]`) as HTMLInputElement | HTMLTextAreaElement | null;
    if (!input) return;
    input.addEventListener("input", () => updateFollowUpCounter(input));
    updateFollowUpCounter(input);
  }

  function setStatus(message: string, tone: "success" | "error" | "info") {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("text-success", "text-danger", "text-fg");

    if (tone === "success") {
      status.classList.add("text-success");
      return;
    }

    if (tone === "error") {
      status.classList.add("text-danger");
      return;
    }

    status.classList.add("text-fg");
  }

  function updateWizardUI() {
    if (!sectionFieldsets.length) return;

    sectionFieldsets.forEach((fieldset, index) => {
      fieldset.classList.toggle("hidden", index !== currentSectionIndex);
    });

    const totalSections = sectionFieldsets.length;
    if (sectionProgress) {
      sectionProgress.textContent = `Section ${currentSectionIndex + 1} of ${totalSections}`;
    }

    if (backButton) {
      backButton.disabled = currentSectionIndex === 0;
    }

    if (nextButton) {
      nextButton.classList.toggle("hidden", currentSectionIndex === totalSections - 1);
    }

    if (submitButton) {
      submitButton.classList.toggle("hidden", currentSectionIndex !== totalSections - 1);
    }
  }

  function validateCurrentSection(): boolean {
    if (!sectionFieldsets.length) return true;
    const currentSection = sectionFieldsets[currentSectionIndex];
    if (!currentSection) return true;

    const requiredControls = Array.from(
      currentSection.querySelectorAll("input[required], textarea[required], select[required]")
    ) as Array<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>;

    for (const control of requiredControls) {
      if (!control.reportValidity()) {
        return false;
      }
    }

    const q19Options = currentSection.querySelectorAll(`input[name="q19"]`) as NodeListOf<HTMLInputElement>;
    if (q19Options.length > 0 && !Array.from(q19Options).some((option) => option.checked)) {
      setStatus("Please select at least one option for practices before continuing.", "error");
      q19Options[0].focus();
      return false;
    }
    return true;
  }

  function goToSection(nextIndex: number) {
    if (!sectionFieldsets.length) return;
    currentSectionIndex = Math.max(0, Math.min(nextIndex, sectionFieldsets.length - 1));
    updateWizardUI();
    setStatus("", "info");
  }

  async function submitSurvey(event: SubmitEvent) {
    event.preventDefault();
    if (!form || !submitButton) return;
    if (currentSectionIndex < sectionFieldsets.length - 1) {
      if (!validateCurrentSection()) return;
      goToSection(currentSectionIndex + 1);
      return;
    }

    setStatus("Submitting...", "info");
    submitButton.setAttribute("disabled", "true");
    submitButton.classList.add("opacity-70", "cursor-not-allowed");

    const formData = new FormData(form);
    const payload: Record<string, string> = {};
    const questionIds = parseStringArray(form.dataset.questionIds);
    const multiQuestionIds = parseStringArray(form.dataset.multiQuestionIds);
    const followUpMappings = parseFollowUpMappings(form.dataset.followUpMappings);

    for (const key of questionIds) {
      if (multiQuestionIds.includes(key)) {
        const values = formData
          .getAll(key)
          .map((value) => (typeof value === "string" ? value.trim() : ""))
          .filter(Boolean);
        payload[key] = values.join("; ");
        continue;
      }

      const value = formData.get(key);
      payload[key] = typeof value === "string" ? value.trim() : "";
    }

    for (const mapping of followUpMappings) {
      const followUpValue = formData.get(mapping.followUpId);
      const cleanFollowUp = typeof followUpValue === "string" ? followUpValue.trim() : "";
      if (!cleanFollowUp) continue;

      payload[mapping.parentId] = payload[mapping.parentId]
        ? `${payload[mapping.parentId]}\nFollow-up: ${cleanFollowUp}`
        : `Follow-up: ${cleanFollowUp}`;
    }

    if (!payload["q19"]) {
      setStatus("Submission failed: Please select at least one practice before submitting.", "error");
      submitButton.removeAttribute("disabled");
      submitButton.classList.remove("opacity-70", "cursor-not-allowed");
      return;
    }

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/${TABLE}`, {
        method: "POST",
        headers: {
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          "Content-Type": "application/json",
          Prefer: "return=minimal",
        },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        let errorText = "Unable to submit survey.";
        try {
          const data = await response.json();
          if (typeof data?.message === "string" && data.message.length > 0) {
            errorText = data.message;
          }
        } catch {
          // ignore json parsing error
        }

        throw new Error(errorText);
      }

      form.reset();
      syncScaleOutputs();
      setStatus("Thank you. Your survey has been submitted.", "success");
    } catch (error) {
      const message = error instanceof Error ? error.message : "Unable to submit survey.";
      setStatus(`Submission failed: ${message}`, "error");
    } finally {
      submitButton.removeAttribute("disabled");
      submitButton.classList.remove("opacity-70", "cursor-not-allowed");
    }
  }

  if (form) {
    form.addEventListener("submit", submitSurvey);

    const followUpMappings = parseFollowUpMappings(form.dataset.followUpMappings);
    const parentIds = Array.from(new Set(followUpMappings.map((mapping) => mapping.parentId)));

    parentIds.forEach((parentId) => {
      const radios = form.querySelectorAll(`input[name="${parentId}"]`);
      radios.forEach((radio) => {
        radio.addEventListener("change", () => updateFollowUpVisibility(parentId));
      });
      updateFollowUpVisibility(parentId);
    });

    followUpMappings.forEach((mapping) => {
      bindFollowUpCounter(mapping.followUpId);
    });
  }

  backButton?.addEventListener("click", () => {
    goToSection(currentSectionIndex - 1);
  });

  nextButton?.addEventListener("click", () => {
    if (!validateCurrentSection()) return;
    goToSection(currentSectionIndex + 1);
  });

  scaleInputs.forEach((input) => {
    input.addEventListener("input", syncScaleOutputs);
  });
  syncScaleOutputs();
  updateWizardUI();
</script>
