---
import Layout from "../layouts/Layout.astro";

type SingleChoiceQuestion = {
  kind: "single";
  id: string;
  number: number;
  text: string;
  options: string[];
  optional?: boolean;
  helpText?: string;
};

type MultiChoiceQuestion = {
  kind: "multi";
  id: string;
  number: number;
  text: string;
  options: string[];
  helpText?: string;
};

type ScaleQuestion = {
  kind: "scale";
  id: string;
  number: number;
  text: string;
  min: number;
  max: number;
  step?: number;
  defaultValue?: number;
  leftLabel: string;
  rightLabel: string;
  helpText?: string;
};

type TextQuestion = {
  kind: "text";
  id: string;
  number: number;
  text: string;
  multiline?: boolean;
  optional?: boolean;
  inputType?: "text" | "email";
  helpText?: string;
};

type Question = SingleChoiceQuestion | MultiChoiceQuestion | ScaleQuestion | TextQuestion;

type Section = {
  id: string;
  title: string;
  questions: Question[];
};

const sections: Section[] = [
  {
    id: "A",
    title: "Section A: About You",
    questions: [
      {
        kind: "single",
        id: "q01",
        number: 1,
        text: "How long have you been using Fast & Pray?",
        options: ["Less than 1 month", "1-3 months", "3-6 months", "6-12 months", "1+ years"],
      },
      {
        kind: "single",
        id: "q02",
        number: 2,
        text: "How often do you use Fast & Pray?",
        options: ["Daily", "A few times a week", "Weekly", "Only during fasting seasons"],
      },
      {
        kind: "single",
        id: "q03",
        number: 3,
        text: "Where are you primarily in your spiritual life right now?",
        options: [
          "New to structured prayer/fasting",
          "Returning after a gap",
          "Consistent but seeking deeper growth",
          "Already very consistent",
        ],
      },
      {
        kind: "single",
        id: "q04",
        number: 4,
        text: "Which tradition best describes you?",
        options: ["Armenian Apostolic", "Other Orthodox", "Catholic", "Protestant", "Other", "Prefer not to say"],
        optional: true,
      },
    ],
  },
  {
    id: "B",
    title: "Section B: Spiritual Impact",
    questions: [
      {
        kind: "text",
        id: "q05",
        number: 5,
        text: "In what ways (if any) has Fast & Pray affected your spiritual life?",
        multiline: true,
      },
      {
        kind: "scale",
        id: "q06",
        number: 6,
        text: "Compared to before using the app, how has your consistency changed?",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Much less consistent",
        rightLabel: "Much more consistent",
        helpText: "Scale: 1 = Much less consistent, 5 = Much more consistent.",
      },
      {
        kind: "scale",
        id: "q07",
        number: 7,
        text: "Prayer consistency",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Lower",
        rightLabel: "Higher",
        helpText: "Use the same 1-5 scale for questions 7-12.",
      },
      {
        kind: "scale",
        id: "q08",
        number: 8,
        text: "Fasting consistency",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Lower",
        rightLabel: "Higher",
      },
      {
        kind: "scale",
        id: "q09",
        number: 9,
        text: "Awareness of the Church's calendar (fasts/feasts/saints)",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Lower",
        rightLabel: "Higher",
      },
      {
        kind: "scale",
        id: "q10",
        number: 10,
        text: "Repentance / self-examination",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Lower",
        rightLabel: "Higher",
      },
      {
        kind: "scale",
        id: "q11",
        number: 11,
        text: "Spiritual focus/attention during the day",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Lower",
        rightLabel: "Higher",
      },
      {
        kind: "scale",
        id: "q12",
        number: 12,
        text: "Participation in the life of the Church (Badarak, services, confession, etc.)",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Lower",
        rightLabel: "Higher",
      },
      {
        kind: "single",
        id: "q13",
        number: 13,
        text: "Has the app helped you understand the meaning of fasting beyond food rules?",
        options: ["Not at all", "A little", "Somewhat", "A lot", "Very much"],
        helpText: "Optional follow-up: If yes, how?",
      },
    ],
  },
  {
    id: "C",
    title: "Section C: Spiritual Community and Solidarity",
    questions: [
      {
        kind: "single",
        id: "q14",
        number: 14,
        text: "When you see that others are joining the same fast or practice, how does it affect you?",
        options: [
          "It encourages me a lot",
          "It encourages me somewhat",
          "No real effect",
          "It makes me feel pressure or comparison sometimes",
        ],
        helpText: "Optional follow-up: If you chose the last option, what would make this healthier?",
      },
      {
        kind: "scale",
        id: "q15",
        number: 15,
        text: "How much has Fast & Pray strengthened your sense of spiritual community?",
        min: 1,
        max: 5,
        defaultValue: 3,
        leftLabel: "Not at all",
        rightLabel: "Very much",
        helpText: "Scale: 1 = Not at all, 5 = Very much.",
      },
      {
        kind: "single",
        id: "q16",
        number: 16,
        text: 'Which best describes your experience of "fasting/praying together" through the app?',
        options: [
          "I feel like I'm not alone in this",
          "I feel a stronger connection to the Church's shared life",
          "It motivates me to be consistent",
          "I don't really notice it",
          "Other",
        ],
      },
      {
        kind: "single",
        id: "q17",
        number: 17,
        text: "Do you prefer the community aspect to be...",
        options: [
          "More visible (more ways to see/join others)",
          "About the same",
          "Less visible (more private)",
        ],
        helpText: "Optional follow-up: Why?",
      },
    ],
  },
  {
    id: "D",
    title: 'Section D: "Everyday Monasticism"',
    questions: [
      {
        kind: "single",
        id: "q18",
        number: 18,
        text: "Has the app helped you build a daily rhythm (a rule of life) that you can actually keep?",
        options: ["Yes", "Somewhat", "Not really", "No"],
        helpText: "Optional follow-up: What does your rhythm look like right now?",
      },
      {
        kind: "multi",
        id: "q19",
        number: 19,
        text: "Which practices has Fast & Pray most helped you keep?",
        options: [
          "Keeping track of fast days",
          "Starting the day with prayer",
          "Evening prayer",
          "Reading Scripture",
          "Acts of mercy/almsgiving",
          "Preparing for confession",
          "Learning about feasts/saints",
        ],
        helpText: "Check all that apply.",
      },
      {
        kind: "single",
        id: "q20",
        number: 20,
        text: "What is the biggest obstacle to keeping a consistent spiritual rhythm?",
        options: ["Time", "Forgetfulness", "Lack of clarity", "Feeling discouraged", "Family schedule", "Work", "Other"],
      },
      {
        kind: "text",
        id: "q21",
        number: 21,
        text: "What in the app most helps you overcome that obstacle?",
        multiline: true,
      },
    ],
  },
  {
    id: "E",
    title: "Section E: What to Improve",
    questions: [
      {
        kind: "text",
        id: "q22",
        number: 22,
        text: "Which parts of Fast & Pray feel most spiritually helpful? Why?",
        multiline: true,
      },
      {
        kind: "text",
        id: "q23",
        number: 23,
        text: "Which parts feel distracting, unclear, or unhelpful?",
        multiline: true,
      },
      {
        kind: "single",
        id: "q24",
        number: 24,
        text: "Have you ever felt guilt, pressure, or comparison from using the app?",
        options: ["Never", "Rarely", "Sometimes", "Often"],
        helpText: "Optional follow-up: If yes, what triggered that feeling?",
      },
      {
        kind: "text",
        id: "q25",
        number: 25,
        text: "What is one feature or change that would most support your spiritual growth?",
        multiline: true,
      },
    ],
  },
  {
    id: "F",
    title: "Section F: Stories and Permission",
    questions: [
      {
        kind: "text",
        id: "q26",
        number: 26,
        text: "Can you share a specific moment where Fast & Pray helped you pray, fast, or return to God?",
        multiline: true,
      },
      {
        kind: "single",
        id: "q27",
        number: 27,
        text: "May we quote your response (anonymously) for improving the app or sharing its mission?",
        options: ["Yes, anonymously", "Yes, with my first name", "No"],
      },
      {
        kind: "text",
        id: "q28",
        number: 28,
        text: "If you're open to a follow-up conversation, leave your email.",
        inputType: "email",
        optional: true,
      },
    ],
  },
];
---

<Layout pageTitle="Fast & Pray Research Survey">
  <section class="text-[#3B0714]">
    <h1 class="text-3xl font-bold">Fast & Pray Research Survey</h1>
    <p class="mt-2 text-sm md:text-base">
      Please complete the survey. Responses are submitted securely for research analysis.
    </p>

    <form id="survey-form" class="mt-8 space-y-8">
      {
        sections.map((section) => (
          <fieldset class="border border-accent rounded-lg p-4 md:p-6">
            <legend class="px-2 text-lg font-semibold">{section.title}</legend>
            <div class="mt-3 space-y-6">
              {section.questions.map((question) => (
                <div class="space-y-3" data-question-id={question.id}>
                  <p class="font-semibold">
                    {question.number}. {question.text}
                  </p>

                  {question.helpText && <p class="text-sm text-[#5B2030]">{question.helpText}</p>}

                  {question.kind === "single" ? (
                    <div class="space-y-2">
                      {question.options.map((option) => (
                        <label class="flex items-start gap-2">
                          <input
                            class="mt-1"
                            type="radio"
                            name={question.id}
                            value={option}
                            required={!question.optional}
                          />
                          <span>{option}</span>
                        </label>
                      ))}
                    </div>
                  ) : question.kind === "scale" ? (
                    <div class="space-y-2">
                      <div class="flex items-center gap-3">
                        <input
                          class="w-full accent-[#B5244A]"
                          type="range"
                          name={question.id}
                          min={question.min}
                          max={question.max}
                          step={question.step ?? 1}
                          value={question.defaultValue ?? Math.round((question.min + question.max) / 2)}
                          data-scale-input={question.id}
                        />
                        <output
                          class="min-w-8 rounded border border-accent px-2 py-1 text-center text-sm font-semibold"
                          data-scale-output={question.id}
                        >
                          {question.defaultValue ?? Math.round((question.min + question.max) / 2)}
                        </output>
                      </div>
                      <div class="flex justify-between text-xs text-[#5B2030]">
                        <span>{question.leftLabel}</span>
                        <span>{question.rightLabel}</span>
                      </div>
                      <div class="flex justify-between text-xs text-[#5B2030]">
                        {Array.from({ length: question.max - question.min + 1 }, (_, i) => question.min + i).map(
                          (value) => (
                            <span>{value}</span>
                          )
                        )}
                      </div>
                    </div>
                  ) : question.kind === "multi" ? (
                    <div class="space-y-2">
                      {question.options.map((option) => (
                        <label class="flex items-start gap-2">
                          <input class="mt-1" type="checkbox" name={question.id} value={option} />
                          <span>{option}</span>
                        </label>
                      ))}
                    </div>
                  ) : question.multiline ? (
                    <textarea
                      class="w-full rounded-md border border-accent p-3 focus:outline-none focus:ring-2 focus:ring-[#B5244A]"
                      name={question.id}
                      rows={5}
                      required={!question.optional}
                    ></textarea>
                  ) : (
                    <input
                      class="w-full rounded-md border border-accent p-3 focus:outline-none focus:ring-2 focus:ring-[#B5244A]"
                      name={question.id}
                      type={question.inputType ?? "text"}
                      required={!question.optional}
                    />
                  )}
                </div>
              ))}
            </div>
          </fieldset>
        ))
      }

      <div class="space-y-3">
        <button
          id="submit-button"
          type="submit"
          class="w-full md:w-auto bg-gradient-to-t from-[#B5244A] to-[#E54670] text-white text-lg py-3 px-8 rounded-full hover:bg-gradient-to-b hover:from-[#B5244A] hover:to-[#E54670]"
        >
          Submit Survey
        </button>
        <p id="survey-status" class="min-h-6 text-sm" aria-live="polite"></p>
      </div>
    </form>
  </section>
</Layout>

<script>
  const SUPABASE_URL = "https://czpmtdcjogaueynyyioi.supabase.co";
  const SUPABASE_ANON_KEY = "sb_publishable_TLJwcn8vXKUnrlXCeJTE-Q_F4_ooUcX";
  const TABLE = "fast_pray_survey_responses";

  const form = document.getElementById("survey-form");
  const status = document.getElementById("survey-status");
  const submitButton = document.getElementById("submit-button");
  const scaleInputs = document.querySelectorAll("input[data-scale-input]");

  function syncScaleOutputs() {
    scaleInputs.forEach((input) => {
      if (!(input instanceof HTMLInputElement)) return;
      const key = input.dataset.scaleInput;
      if (!key) return;
      const output = document.querySelector(`output[data-scale-output="${key}"]`);
      if (output) {
        output.textContent = input.value;
      }
    });
  }

  function setStatus(message, tone) {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("text-green-700", "text-red-700", "text-[#3B0714]");

    if (tone === "success") {
      status.classList.add("text-green-700");
      return;
    }

    if (tone === "error") {
      status.classList.add("text-red-700");
      return;
    }

    status.classList.add("text-[#3B0714]");
  }

  async function submitSurvey(event) {
    event.preventDefault();
    if (!form || !submitButton) return;

    setStatus("Submitting...", "info");
    submitButton.setAttribute("disabled", "true");
    submitButton.classList.add("opacity-70", "cursor-not-allowed");

    const formData = new FormData(form);
    const payload = {};

    for (let i = 1; i <= 28; i += 1) {
      const key = `q${String(i).padStart(2, "0")}`;

      if (key === "q19") {
        const values = formData
          .getAll(key)
          .map((value) => (typeof value === "string" ? value.trim() : ""))
          .filter(Boolean);
        payload[key] = values.join("; ");
      } else {
        const value = formData.get(key);
        payload[key] = typeof value === "string" ? value.trim() : "";
      }
    }

    if (!payload.q19) {
      setStatus("Submission failed: Please select at least one option for question 19.", "error");
      submitButton.removeAttribute("disabled");
      submitButton.classList.remove("opacity-70", "cursor-not-allowed");
      return;
    }

    try {
      const response = await fetch(`${SUPABASE_URL}/rest/v1/${TABLE}`, {
        method: "POST",
        headers: {
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          "Content-Type": "application/json",
          Prefer: "return=minimal",
        },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        let errorText = "Unable to submit survey.";
        try {
          const data = await response.json();
          if (typeof data?.message === "string" && data.message.length > 0) {
            errorText = data.message;
          }
        } catch {
          // ignore json parsing error
        }

        throw new Error(errorText);
      }

      form.reset();
      syncScaleOutputs();
      setStatus("Thank you. Your survey has been submitted.", "success");
    } catch (error) {
      const message = error instanceof Error ? error.message : "Unable to submit survey.";
      setStatus(`Submission failed: ${message}`, "error");
    } finally {
      submitButton.removeAttribute("disabled");
      submitButton.classList.remove("opacity-70", "cursor-not-allowed");
    }
  }

  if (form) {
    form.addEventListener("submit", submitSurvey);
  }

  scaleInputs.forEach((input) => {
    input.addEventListener("input", syncScaleOutputs);
  });
  syncScaleOutputs();
</script>
